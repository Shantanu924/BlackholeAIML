# ============================================================
# VAJRA Intelligence Layer — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── VAJRA Connectivity ───────────────────────────────────────
# Public-facing VAJRA host (read-only reference)
VAJRA_BASE_URL=http://vajra.blackholeinfiverse.com

# Internal VAJRA API base URL (set this to flip adapters from SIMULATED → LIVE)
# Leave blank to run in fully SIMULATED mode.
VAJRA_INTERNAL_URL=

# VAJRA API key for authenticated internal endpoints
VAJRA_API_KEY=

# HTTP timeout (seconds) for outbound VAJRA calls
VAJRA_TIMEOUT_SECONDS=5

# ── Intelligence Service ─────────────────────────────────────
SERVICE_NAME=vajra-intelligence
SERVICE_VERSION=1.0.0
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8100

# ── Evidence Store ───────────────────────────────────────────
# Path to SQLite advisory evidence database (relative to package root)
EVIDENCE_DB_PATH=data/intelligence_evidence.db

# ── Risk Thresholds ──────────────────────────────────────────
RISK_SCORE_MEDIUM=2
RISK_SCORE_HIGH=4
RISK_SCORE_CRITICAL=6
FREQ_ABUSE_THRESHOLD=5
OFF_HOURS_START=0
OFF_HOURS_END=6
